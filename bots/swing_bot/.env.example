# Copie ce fichier vers .env et renseigne tes cles API Coinbase Advanced Trade (CDP).
# .env est ignore par git. Ne partage JAMAIS ces valeurs.
#
# Cree une cle ici : https://portal.cdp.coinbase.com/  (Onglet "API Keys")
# Permissions minimales conseillees :
#   - Paper trading  : "View" uniquement (lecture des comptes) -- ou aucune cle (data publique).
#   - Live trading    : "View" + "Trade". NE PAS activer "Transfer" (pas de retrait).
#
# Le format CDP moderne :
#   COINBASE_API_KEY    = organizations/xxxx/apiKeys/xxxx
#   COINBASE_API_SECRET = -----BEGIN EC PRIVATE KEY-----\n....\n-----END EC PRIVATE KEY-----\n
# (garde les \n litteraux OU mets la cle multi-ligne entre guillemets)

COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Notifications Telegram (optionnel) ---
# 1. Ouvre @BotFather, /newbot -> recupere le token ci-dessous.
# 2. Ecris un message a ton nouveau bot (sinon il ne peut pas te repondre).
# 3. Recupere ton chat_id : ouvre
#      https://api.telegram.org/bot<TON_TOKEN>/getUpdates
#    et lis "chat":{"id": ...}   (ou passe par @userinfobot)
# 4. config.yaml -> notifications.enabled: true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
