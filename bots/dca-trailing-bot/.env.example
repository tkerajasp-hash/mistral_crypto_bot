# ---------------------------------------------------------------------------
# DCA Trailing Bot - Variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en .env et remplissez avec vos clés

# Coinbase API Keys (requises pour le live trading)
COINBASE_API_KEY=votre_clé_api_coinbase
COINBASE_API_SECRET=votre_secret_api_coinbase

# Discord Webhook (optionnel, pour les notifications)
# Pour créer un webhook :
# 1. Allez sur votre serveur Discord
# 2. Paramètres du serveur → Intégrations → Webhooks
# 3. Nouveau Webhook → Copier le lien
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/XXX

# ---------------------------------------------------------------------------
# Instructions :
# 1. cp .env.example .env
# 2. Éditez .env avec vos clés
# 3. Ne commitez JAMAIS le fichier .env dans Git
# ---------------------------------------------------------------------------
